# Copy to .env (gitignored). Read by docker compose and `make dev`.
# local = team area open without a password. production = TEAM_PASSWORD required.
APP_ENV=local
# Shared password for /team (any username). Real value: see the password manager.
TEAM_PASSWORD=
# Optional overrides for links in content/site.yaml (SILTA_<KEY>_URL).
SILTA_CONSUMER_URL=
SILTA_COUNTY_URL=
SILTA_ADMIN_URL=
SILTA_SITE_URL=
